# Server & Runtime Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL direct session connection)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supastore

# Authentication & Bootstrap Secrets
ADMIN_SETUP_SECRET=change-me-to-a-secure-random-secret-for-bootstrap
BETTER_AUTH_SECRET=change-me-to-a-secure-random-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# S3 Compatible Object Storage (Optional for M0 slice)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=supastore-public
S3_BUCKET_PRIVATE=supastore-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# SMTP Email Configuration (Optional for M0 mock adapter)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@supastore.local
