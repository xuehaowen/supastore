# Runtime and logging
# Local development: backend :3000, storefront :3001.
# Export port overrides in the shell when using the development launchers.
NODE_ENV=development
PORT=3000
# Bind to loopback when a host TLS reverse proxy fronts Docker (see docs/security-deployment.md).
STOREFRONT_BIND=127.0.0.1
BACKEND_PORT=3000
STOREFRONT_PORT=3001
LOG_LEVEL=debug
LOG_PANEL_ENABLED=false

# Optional per-instance release image references. Leave blank for local defaults.
# Use versioned tags or registry digests for releases; build tags must be writable tags.
BACKEND_IMAGE=
STOREFRONT_IMAGE=
MIGRATION_IMAGE=

# Application origins and proxy
# APP_URL, BETTER_AUTH_URL and STOREFRONT_ORIGIN refer to the public storefront origin.
# For Docker/production, set the actual published origin. Compose requires STOREFRONT_ORIGIN.
# BACKEND_URL is the private server-to-server API origin.
# EDGE_PROXY_SECRET is optional; blank rejects forwarded client-IP headers.
# Public production requires the trusted ingress setup in docs/security-deployment.md.
# Validate the target with pnpm check:deployment --connect from its release checkout.
# Authentication counters are shared in PostgreSQL; staff enroll MFA in Account security.
# A trusted edge must overwrite its token and single client-IP headers.
APP_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
STOREFRONT_ORIGIN=http://localhost:3001
BACKEND_URL=http://127.0.0.1:3000
EDGE_PROXY_SECRET=

# Database connections
# Use PostgreSQL direct session connections; URL-encode credentials.
# Runtime uses the application role; migrations use an administrator connection.
# Keep local database names/credentials consistent with the provisioning section below.
DATABASE_URL=postgresql://supastore_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/supastore
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/supastore

# Database provisioning (Docker and migration tooling)
# For multiple stores, use explicit unique Compose project names and per-store env files.
# Host ports below can differ; service-to-service ports remain unchanged.
# These do not change the database selected by an existing DATABASE_URL.
# Set both role passwords before provisioning; do not use application credentials as admin credentials.
POSTGRES_USER=postgres
POSTGRES_DB=supastore
POSTGRES_PORT=5432
ADMINER_PORT=9002
POSTGRES_PASSWORD=
APP_DATABASE_USER=supastore_app
APP_DATABASE_PASSWORD=

# Database connection limits
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000

# Authentication and bootstrap
# Admin accounts are provisioned through trusted terminal tooling.
# Use independent generated secrets; BETTER_AUTH_SECRET should be at least 32 characters.
ADMIN_SETUP_SECRET=
BETTER_AUTH_SECRET=

# S3-compatible object storage
# Public catalog assets and private payment evidence use separate buckets.
S3_ENDPOINT=http://localhost:9000
# Optional browser-reachable S3 origin for signed uploads/downloads; defaults to
# S3_ENDPOINT outside Compose. Compose defaults to localhost at S3_API_PORT.
# Set an HTTPS storage origin reachable by customers for public deployment.
S3_PUBLIC_ENDPOINT=
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=supastore-public
S3_BUCKET_PRIVATE=supastore-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Background notifications
# ENABLE_OUTBOX_WORKER starts the backend's queued email/background jobs.
# Set DISABLE_OUTBOUND_DELIVERY=true for restored fixtures or deliberate delivery suppression.
ENABLE_OUTBOX_WORKER=true
DISABLE_OUTBOUND_DELIVERY=false

# Email transport (backend only)
# EMAIL_PROVIDER: nodemailer, nodemailer-oauth2, or disabled.
# Example defaults target a local SMTP catcher; configure a real provider to reach inboxes.
# TLS defaults: implicit TLS on port 465; STARTTLS required for non-loopback hosts.
# Uncomment TLS overrides only when needed; keep TLS enabled for external providers.
EMAIL_PROVIDER=nodemailer
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=true
# SMTP_REQUIRE_TLS=true
SMTP_FROM=noreply@supastore.local
SMTP_USER=
SMTP_PASSWORD=

# Email OAuth2 (optional)
# Used only by nodemailer-oauth2; SMTP_PASSWORD is ignored in OAuth2 mode.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and your Gmail SMTP_USER.
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=

# Telnyx SMS and phone verification (backend only)
# SMS_PROVIDER: disabled (silent), console (development previews), or telnyx.
# Console mode logs eligible messages with masked recipients; it does not send SMS.
# Phone verification: disabled or telnyx. Live sending requires SMS_LIVE_AUTHORIZED=true.
# DISABLE_OUTBOUND_DELIVERY=true also suppresses console previews.
# Previews require ENABLE_OUTBOX_WORKER=true and existing verified consent.
# Restart the backend after changes; Docker Compose must recreate the backend.
# TELNYX_FROM uses E.164 format, e.g. +15551234567.
# The Chinese Verify profile is optional; the public key verifies signed callbacks.
# Webhook path: /api/notifications/telnyx
SMS_PROVIDER=disabled
SMS_LIVE_AUTHORIZED=false
PHONE_VERIFICATION_PROVIDER=disabled
TELNYX_API_KEY=
TELNYX_FROM=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_VERIFY_PROFILE_ID=
TELNYX_VERIFY_PROFILE_ID_ZH=
TELNYX_PUBLIC_KEY=

# Stripe card payments (optional, backend only)
# Blank credentials leave Stripe unconfigured. Use test credentials in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Carrier callbacks (optional, backend only)
# Blank provider/secret keep trusted carrier callbacks disabled.
CARRIER_WEBHOOK_PROVIDER=
CARRIER_WEBHOOK_SECRET=

# Report resource limits
REPORT_MAX_SOURCE_ROWS=100000
REPORT_MAX_EXPORT_BYTES=67108864
REPORT_TIMEOUT_MS=30000

# Container Node.js memory limits
# Used by Docker Compose; these do not set development-launcher heap limits.
BACKEND_NODE_OPTIONS=--max-old-space-size=256
STOREFRONT_NODE_OPTIONS=--max-old-space-size=256

# Optional storefront analytics
# Public HTTPS endpoint; blank disables analytics. Browser consent is required.
# Set at build time; Docker Compose passes this value to the storefront build.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
