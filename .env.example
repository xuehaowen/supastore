# Server & Runtime Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug
LOG_PANEL_ENABLED=false

# Database (PostgreSQL direct session connection)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supastore

# Authentication & Bootstrap Secrets
ADMIN_SETUP_SECRET=change-me-to-a-secure-random-secret-for-bootstrap
BETTER_AUTH_SECRET=change-me-to-a-secure-random-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# Public browser origin for storefront, API, auth and admin.
# For two local dev processes use http://localhost:3001 instead.
STOREFRONT_ORIGIN=http://localhost:3000
# Storefront server only; receives no database, storage, SMTP or Stripe secrets.
BACKEND_URL=http://127.0.0.1:3000
# Storefront-only optional ingress secret. Blank rejects all forwarded client IPs.
# A trusted HTTPS edge must overwrite the token and single client-IP headers.
EDGE_PROXY_SECRET=
BACKEND_PORT=3000
ENABLE_OUTBOX_WORKER=true

# Backend-only optional online card payments. Use test credentials in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional trusted carrier gateway (backend only). Empty keeps callbacks disabled.
CARRIER_WEBHOOK_PROVIDER=
CARRIER_WEBHOOK_SECRET=

# S3 Compatible Object Storage (RustFS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=supastore-public
S3_BUCKET_PRIVATE=supastore-private
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

# Backend email transport. Disabled channels never fall back to successful mocks.
EMAIL_PROVIDER=nodemailer
# Switch to nodemailer-oauth2 for Gmail OAuth; SMTP_PASSWORD is ignored in OAuth mode.
# Use SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true and your Gmail SMTP_USER.
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@supastore.local
# Optional: implicit TLS defaults on port 465; STARTTLS defaults required off-loopback.
# SMTP_SECURE=true
# SMTP_REQUIRE_TLS=true

# Optional Telnyx SMS/Verify (backend only). Live sending remains disabled.
SMS_PROVIDER=disabled
PHONE_VERIFICATION_PROVIDER=disabled
TELNYX_API_KEY=
TELNYX_FROM=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_VERIFY_PROFILE_ID=
TELNYX_VERIFY_PROFILE_ID_ZH=
TELNYX_PUBLIC_KEY=
