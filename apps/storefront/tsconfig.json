{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@supastore/contracts": ["../../packages/contracts/src/index.ts"],
      "@supastore/contracts/*": ["../../packages/contracts/src/*"],
      "@supastore/ui/utils": ["../../packages/ui/src/utils.ts"],
      "@supastore/ui/*": ["../../packages/ui/src/components/ui/*"],
      "@supastore/i18n/messages": ["../../packages/i18n/src/app/messages.ts"],
      "@supastore/i18n/customer": ["../../packages/i18n/src/customer.ts"],
      "@supastore/i18n/*": ["../../packages/i18n/src/*"],
      "@supastore/shipping/*": ["../../packages/shipping/src/*"],
      "@shared-i18n/*": ["../../packages/i18n/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next-cuj"]
}
