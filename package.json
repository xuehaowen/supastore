{
  "name": "supastore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "pnpm run build:backend && pnpm run build:storefront",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/dev.mjs start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/backend/tsconfig.json && tsc --noEmit -p apps/storefront/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:errors": "vitest run --config vitest.errors.config.ts --coverage",
    "test:integration": "node scripts/test-integration.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:storefront": "node scripts/test-storefront.mjs",
    "test:storefront:unit": "vitest run apps/storefront/lib",
    "test:all": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:unit && pnpm run test:storefront:unit && pnpm run test:integration && pnpm run test:browser",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "node scripts/test-browser.mjs",
    "db:seed": "tsx scripts/seed-demo.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "bench:search": "tsx scripts/measure-search.ts",
    "bench:memory": "node scripts/test-storefront.mjs --measure",
    "bench:memory:analyze": "tsx scripts/benchmark/analyze-memory.ts",
    "bench:fixture": "node scripts/test-integration.mjs tests/integration/benchmark-fixture.test.ts",
    "bench:representative": "node scripts/test-storefront.mjs --benchmark",
    "auth:recover-owner": "tsx scripts/recover-owner.ts",
    "test:browser:existing": "playwright test",
    "test:frontend:coverage": "vitest run tests/unit --coverage --coverage.include=apps/backend/src/app/actions.ts --coverage.include=apps/backend/src/app/client-requests.ts",
    "dev:backend": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backend.mjs dev",
    "dev:storefront": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/storefront.mjs",
    "build:backend": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/backend.mjs build",
    "build:storefront": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/storefront.mjs build",
    "typecheck:storefront": "tsc --noEmit -p apps/storefront/tsconfig.json",
    "test:containers": "node scripts/test-container-acceptance.mjs",
    "bench:storefront": "node scripts/measure-storefront-bundle.mjs",
    "check:services": "node scripts/check-release-services.mjs",
    "check:deployment": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/check-deployment.mjs",
    "typecheck:backend": "tsc --noEmit -p apps/backend/tsconfig.json",
    "start:backend": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/backend.mjs start",
    "start:storefront": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/storefront.mjs start",
    "demo": "node scripts/demo.mjs",
    "test:demo": "node scripts/test-demo.mjs",
    "dev:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/worker.mjs",
    "start:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/worker.mjs start"
  },
  "devDependencies": {
    "better-auth": "^1.1.18",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.9",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "valibot": "^1.4.2",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.8",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.7",
    "js-yaml": "^5.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "@supastore/contracts": "workspace:*",
    "@supastore/i18n": "workspace:*",
    "@supastore/shipping": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.0.9"
}
