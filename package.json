{
  "name": "supastore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit tests/e2e",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/test-integration.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:storefront": "node scripts/test-storefront.mjs",
    "test:storefront:unit": "vitest run apps/storefront/lib",
    "test:all": "npm run typecheck && npm run typecheck:storefront && npm test && npm run test:storefront:unit && npm run test:integration && npm run test:browser && npm run test:storefront",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "node scripts/test-browser.mjs",
    "db:seed": "tsx scripts/seed-demo.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "bench:search": "tsx scripts/measure-search.ts",
    "bench:memory": "tsx scripts/benchmark-memory.ts",
    "auth:recover-owner": "tsx scripts/recover-owner.ts",
    "test:browser:existing": "playwright test",
    "test:frontend:coverage": "vitest run tests/unit --coverage --coverage.include=src/app/actions.ts --coverage.include=src/app/client-requests.ts",
    "dev:backend": "node scripts/backend.mjs dev",
    "dev:storefront": "next dev apps/storefront -p 3001",
    "build:backend": "node scripts/backend.mjs build",
    "build:storefront": "next build apps/storefront",
    "typecheck:storefront": "tsc --noEmit -p apps/storefront/tsconfig.json",
    "test:containers": "node scripts/test-container-acceptance.mjs",
    "bench:storefront": "node scripts/measure-storefront-bundle.mjs",
    "check:services": "node scripts/check-release-services.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@base-ui/react": "^1.8.0",
    "better-auth": "^1.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.39.3",
    "exceljs": "^4.4.0",
    "lru-cache": "^11.0.2",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-intl": "^3.26.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.30.4",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.7",
    "js-yaml": "^5.4.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.7",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
